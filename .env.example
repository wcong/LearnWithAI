# ── LearnWithAI 生产环境配置 ──

# 运行环境: development / production
ENV=production

# 服务端口
HOST=0.0.0.0
PORT=7860

# ── LLM 配置 ──
LLM_PROVIDER=openai          # openai / anthropic / ollama
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxxxxxxxxxx
# LLM_API_BASE=https://api.openai.com/v1  # 自定义 base_url

# ── Langfuse 可观测性（可选） ──
# 开启后自动追踪所有 Agent/LLM 调用，在 Langfuse UI 中查看调用链路。
# 注册地址: https://cloud.langfuse.com
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # 自部署时修改为你的地址

# ── JWT 认证 ──
# 生产环境请务必修改为随机字符串！！！
JWT_SECRET=replace-with-a-long-random-secret-string

# ── Plan 检查点数据库（可选） ──
# 设置此项后，LangGraph 检查点将存储到 MySQL 而非本地的 SQLite 文件。
# 需要 MySQL >= 8.0.19 或 MariaDB >= 10.7.1
# PLAN_CHECKPOINT_DB_URL=mysql://user:password@host:3306/dbname
